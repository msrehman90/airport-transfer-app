# ---------------------------------------------------------------------------
# Copy this file to .env.local. Every key is optional: anything left blank
# falls back to Demo Mode (LocalStorage bookings, mock payments, mock flights).
# ---------------------------------------------------------------------------

# Public site URL (used in emails and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (leave blank to run in LocalStorage demo mode)
# Dashboard → Project Settings → API Keys. Use the new keys:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = Publishable key (sb_publishable_...)
#   SUPABASE_SERVICE_ROLE_KEY     = Secret key (sb_secret_...) — server only, never share
# (Legacy anon / service_role JWT keys also work until Supabase retires them.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Maps (Places API New autocomplete + Routes API distances). Blank = OpenStreetMap/Nominatim fallback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional server key for the Routes API (if your browser key is restricted to your website)
GOOGLE_MAPS_SERVER_KEY=

# Payments (blank = mock payment confirmation)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flight Tracking (blank = simulated flight status)
AIRLABS_API_KEY=
CRON_SECRET=

# Email (blank = emails are logged to the server console)
RESEND_API_KEY=
FROM_EMAIL=bookings@yourdomain.com
DISPATCH_EMAIL=dispatch@yourdomain.com

# Admin / Driver passcodes (always used to sign in to /admin and /driver)
ADMIN_PASSCODE=admin123
DRIVER_PASSCODE=driver123
# Secret used to sign the admin/driver session cookie. Set a long random string in production.
SESSION_SECRET=
